; Pasture3D Water — Ocean preset, high tier. Spec §6.
;
; The default for Pasture3D.ocean_material (constants.h OCEAN_MATERIAL_PATH).
;
; The look is GarrettGunnell/Water's SampleScene (PASTURE3D_WATER_REFERENCE_SPEC.md §2, R5): its
; foam colour, and crest foam at full strength (the reference has no multiplier). scatter_color,
; sun_roughness, bubbles, scatter strengths, foam_roughness_modifier and environment_light_strength
; are the shader's defaults, which ARE the reference's values, so they are not repeated here.
; Every colour is the reference's number sRGB-encoded: its script passes colours with SetVector,
; unconverted, so its numbers are linear, and source_color linearises what it is given. Its sun,
; (1, 0.694, 0.32), is a DirectionalLight3D coloured (1, 0.851, 0.601) at energy 1 for the same reason.
; absorption, deep_color (the underwater fog) and the shore foam are ours: the reference has
; nothing to say about water you can see the bottom of (decision D4). The reference reflects a
; cubemap (use_environment_map); none ships, so this reflects Godot's sky. Its scene's camera
; far plane is 2000 m, and the far-plane fades are tuned to it.
;
; Note what is NOT here: the waves. They are the manager's wave profile (FFT, or the
; fBm fallback), uploaded into the duplicate the ocean draws with, because the CPU
; height query has to answer from the same model. Shape the ocean's waves on its
; profile in Pasture3DPoolManager.profiles, not with this resource. Nor is there a
; detail texture: the FFT's short cascades draw what it stood in for.
;
; NOTHING `_`-PREFIXED BELONGS IN HERE. Those uniforms are written by the plugin --
; _wave_model / _fft_* / _fbm_* by the manager, _mesh_size / _subdiv / _vertex_spacing / _target_pos by the
; clipmap, _water_domain_origin per instance -- and Pasture3DPoolManager::
; is_plugin_written_param() skips every one of them when syncing a preset into the
; duplicate a body draws with. Storing them here is inert at best and misleading at
; worst.
;
; They were here once: opening this material in the inspector and saving it
; serialises whatever the plugin had just written into it, which is how an all-zero
; wave table and a stale _mesh_size of 32 got committed in 6967bdd, and how these
; comments got stripped (Godot's resource writer does not preserve them). If this
; header is missing and `_`-prefixed parameters are back, that is what happened --
; delete them and restore this block. M_water_ocean_low.tres is the untouched
; reference for what this file should look like.
[gd_resource type="ShaderMaterial" format=4 uid="uid://cu5tyca37mw4v"]

[ext_resource type="Shader" uid="uid://dwc65bc2s82vl" path="res://addons/pasture_3d/extras/shaders/water/water_ocean.gdshader" id="1_shader"]
[ext_resource type="Texture2D" uid="uid://dps0nipf3at3t" path="res://addons/pasture_3d/extras/shaders/water/HeightOceanFoam.png" id="3_mewtu"]

[resource]
render_priority = 0
shader = ExtResource("1_shader")
shader_parameter/absorption = Vector3(0.35, 0.08, 0.05)
shader_parameter/deep_color = Color(0.015, 0.05, 0.08, 1)
shader_parameter/sea_level = 0.0
shader_parameter/base_roughness = 0.06
shader_parameter/specular_amount = 0.5
shader_parameter/foam_tex = ExtResource("3_mewtu")
shader_parameter/foam_color = Color(0.797738, 0.771597, 0.730063, 1)
shader_parameter/foam_scale = 0.07
shader_parameter/foam_crest_amount = 1.0
shader_parameter/foam_shore_depth = 1.2
shader_parameter/foam_shore_amount = 0.381
shader_parameter/wave_peak_scatter = 1.0
